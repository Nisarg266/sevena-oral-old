<style>
body {font-family: Arial;}

/* Style the tab */
.tab {
  overflow: hidden;
/*   border: 1px solid #ccc;
  background-color: #f1f1f1; */
}

/* Style the buttons inside the tab */
.tab button {
  background-color: inherit;
  float: left;
  border: none;
  outline: none;
  cursor: pointer;
  padding: 14px 16px;
  transition: 0.3s;
  padding: 13px 20px;
    border-radius: 100px;
    border: solid 2px #3e3e3f;
    font-size: 16px;
    font-weight: 600;
    font-stretch: normal;
    font-style: normal;
    line-height: 1.25;
    letter-spacing: 0.64px;
    text-align: center;
    color: #3e3e3f;
    text-transform: uppercase;
    margin-right: 1em;
}

/* Change background color of buttons on hover */
.tab button:hover {
  background-color: #3e3e3f;
    color: #fff;
}

/* Create an active/current tablink class */
.tab button.active {
 background-color: #3e3e3f;
    color: #fff;
}

/* Style the tab content */
.tabcontent {
  display: none;
  padding: 6px 0px;
  border: 0px solid #ccc;
  border-top: none;
}
</style>
{% section 'faq-intro' %}

<div class="page-width">
<div class="tab">
  <button class="tablinks" onclick="openCity(event, 'London')" id="defaultOpen">SuperBrush</button>
  <button class="tablinks" onclick="openCity(event, 'Paris')">Shipping & RETURNs</button>
  <button class="tablinks" onclick="openCity(event, 'Tokyo')">WARRANTY</button>
</div>

<div id="London" class="tabcontent">
 {% section 'faqs1' %}
</div>

<div id="Paris" class="tabcontent">
  {% section 'faqs2' %}
</div>

<div id="Tokyo" class="tabcontent">
  {% section 'faqs3' %}
</div>
</div>

<script>
function openCity(evt, cityName) {
  var i, tabcontent, tablinks;
  tabcontent = document.getElementsByClassName("tabcontent");
  for (i = 0; i < tabcontent.length; i++) {
    tabcontent[i].style.display = "none";
  }
  tablinks = document.getElementsByClassName("tablinks");
  for (i = 0; i < tablinks.length; i++) {
    tablinks[i].className = tablinks[i].className.replace(" active", "");
  }
  document.getElementById(cityName).style.display = "block";
  evt.currentTarget.className += " active";
}

// Get the element with id="defaultOpen" and click on it
document.getElementById("defaultOpen").click();
</script>









