{% if section.settings.show_section %}

{%- style -%}
  .discount-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s;
    backdrop-filter: blur(5px);
  }

  .discount-popup-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .discount-popup-container {
    position: relative;
    width: 95%;
    max-width: 850px;
    min-height: 500px;
    background-size: cover;
    background-position: center;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.4);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px;
    color: #fff;
    font-family: var(--font-body-family), sans-serif;
  }

  .discount-popup-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .discount-popup-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 100%);
    z-index: 1;
  }

  .discount-popup-content {
    position: relative;
    z-index: 2;
    max-width: 450px;
  }

  .discount-popup-close {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 30px;
    height: 30px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    transition: transform 0.2s;
  }

  .discount-popup-close:hover {
    transform: scale(1.1);
  }

  .discount-popup-close svg {
    width: 16px;
    height: 16px;
    fill: #333;
  }

  .discount-popup-heading-small {
    font-size: 1.8rem;
    font-style: italic;
    margin-bottom: 10px;
    font-weight: 300;
  }

  .discount-popup-heading-large {
    font-size: 3.6rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 25px;
    text-transform: uppercase;
    color: #ffffff !important;
  }

  .discount-popup-description {
    font-size: 1.6rem;
    margin-bottom: 25px;
    font-weight: 400;
  }

  .discount-popup-form .field {
    margin-bottom: 15px;
  }

  .discount-popup-form input {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1.4rem;
    background: #fff;
    color: #333;
  }

  .discount-popup-submit {
    width: 100%;
    padding: 15px;
    background: #c5b3a3;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 1.6rem;
    font-weight: 600;
    cursor: pointer;
    text-transform: uppercase;
    transition: background 0.3s;
    margin-top: 10px;
  }

  .discount-popup-submit:hover {
    background: #b09c8a;
  }

  .discount-popup-success {
    display: none;
    text-align: center;
    animation: fadeIn 0.5s ease;
    position: relative;
    z-index: 2;
  }

  .discount-popup-code-box {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border: 2px dashed #fff;
    padding: 40px 20px;
    margin: 20px 0;
    border-radius: 8px;
  }

  .discount-popup-code {
    font-size: 3.6rem;
    font-weight: 800;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 12px;
    color: #000000 !important;
  }

  .discount-popup-copy {
    background: #000000;
    color: #ffffff;
    border: none;
    padding: 12px 25px;
    border-radius: 4px;
    font-size: 1.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 140px;
    user-select: none;
    -webkit-user-select: none;
    position: relative;
    z-index: 3;
    pointer-events: auto;
    touch-action: manipulation;
  }

  .discount-popup-copy:hover {
    background: #333333;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media screen and (max-width: 749px) {
    .discount-popup-container {
      padding: 30px 20px;
      min-height: auto;
    }
    .discount-popup-heading-large {
      font-size: 2.4rem;
    }
    .discount-popup-content {
      max-width: 100%;
    }
  }
{%- endstyle -%}

{%- assign popup_fallback_image = 'https://cdn.shopify.com/s/files/1/0765/9021/9549/files/POP_UP.png?v=1774270785' -%}
{%- assign popup_background_src = popup_fallback_image -%}
{%- if section.settings.image != blank -%}
  {%- assign popup_background_src = section.settings.image | img_url: 'master' -%}
{%- endif -%}

<div id="DiscountPopupOverlay" class="discount-popup-overlay" data-delay="{{ section.settings.delay | times: 1000 }}">
  <div
    class="discount-popup-container"
    style="background-image: url('{{ popup_background_src }}'); background-color: #1a1a1a;"
  >
    <div class="discount-popup-close" id="DiscountPopupClose">
      <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z"/></svg>
    </div>

    <!-- STEP 1: COLLECT DATA -->
    <div class="discount-popup-content" id="DiscountPopupMain">
      <div class="discount-popup-heading-small">{{ section.settings.heading_small }}</div>
      <h2 class="discount-popup-heading-large">{{ section.settings.heading_large }}</h2>
      <p class="discount-popup-description">{{ section.settings.description }}</p>

      {%- form 'customer', id: 'DiscountPopupForm', class: 'discount-popup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, popup-discount">
        <div class="field">
          <input type="email" name="contact[email]" placeholder="email@xyz.com" required>
        </div>
        <div class="field">
          <input type="tel" name="contact[phone]" placeholder="10-digit mobile number" pattern="[0-9]{10}" maxlength="10">
        </div>
        <button type="button" class="discount-popup-submit" id="DiscountPopupSubmit">Unlock Now</button>
      {%- endform -%}
    </div>

    <!-- STEP 2: REVEAL CODE -->
    <div class="discount-popup-success" id="DiscountPopupSuccess">
      <h2 class="discount-popup-heading-large">Your Code is Ready!</h2>
      <div class="discount-popup-code-box">
        <span class="discount-popup-code">{{ section.settings.discount_code }}</span>
        
        <button
          type="button"
          class="discount-popup-copy"
          id="DiscountPopupCopyBtn"
          data-code="{{ section.settings.discount_code | escape }}"
        >
          <span id="CopyBtnText">Copy Code</span>
          <span id="CopyBtnTick" style="display:none;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="vertical-align: middle; margin-right: 5px;"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
            Copied!
          </span>
        </button>

        {% if section.settings.disclaimer != blank %}
          <p style="font-size: 1.2rem; margin-top: 15px; color: #000000; font-weight: 500;">{{ section.settings.disclaimer }}</p>
        {% endif %}
      </div>
      <p>{{ section.settings.success_description }}</p>
    </div>
  </div>
</div>

<script>
(function() {
  function initDiscountPopup() {
    const overlay = document.getElementById('DiscountPopupOverlay');
    if (!overlay || overlay.getAttribute('data-popup-initialized') === 'true') return;

    // 1. Visibility logic
    const delay = parseInt(overlay.getAttribute('data-delay')) || 3000;
    if (!localStorage.getItem('discount_popup_seen')) {
      setTimeout(function() {
        var el = document.getElementById('DiscountPopupOverlay');
        if (el) el.classList.add('is-active');
      }, delay);
    }

    // Use event delegation on the overlay so it works even after slow/late rendering
    overlay.addEventListener('click', function(e) {
      var target = e.target;

      // 2. Close on overlay background click
      if (target === overlay) {
        overlay.classList.remove('is-active');
        localStorage.setItem('discount_popup_seen', 'true');
        return;
      }

      // 2b. Close button
      if (target.closest('#DiscountPopupClose')) {
        overlay.classList.remove('is-active');
        localStorage.setItem('discount_popup_seen', 'true');
        return;
      }

      // 3. Form submit button
      if (target.closest('#DiscountPopupSubmit')) {
        var form = document.getElementById('DiscountPopupForm');
        if (!form) return;

        var email = form.querySelector('input[type="email"]').value;
        var phone = form.querySelector('input[type="tel"]').value;

        if (!email || !email.includes('@')) {
          alert('Please enter a valid email.');
          return;
        }
        if (phone && phone.length !== 10) {
          alert('Please enter a 10-digit phone number.');
          return;
        }

        var mainArea = document.getElementById('DiscountPopupMain');
        var successArea = document.getElementById('DiscountPopupSuccess');
        if (mainArea) mainArea.style.display = 'none';
        if (successArea) successArea.style.display = 'block';
        localStorage.setItem('discount_popup_seen', 'true');

        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' }
        });
        return;
      }

      // 4. Copy discount code
      var copyBtn = target.closest('#DiscountPopupCopyBtn');
      if (copyBtn) {
        e.preventDefault();
        e.stopPropagation();

        var code = copyBtn.getAttribute('data-code') || '';
        if (!code) return;

        function setCopyFeedback() {
          var btnText = document.getElementById('CopyBtnText');
          var btnTick = document.getElementById('CopyBtnTick');
          if (btnText) btnText.style.display = 'none';
          if (btnTick) btnTick.style.display = 'inline-block';
          copyBtn.style.backgroundColor = '#4caf50';
          setTimeout(function() {
            if (btnText) btnText.style.display = 'inline-block';
            if (btnTick) btnTick.style.display = 'none';
            copyBtn.style.backgroundColor = '#000000';
          }, 2000);
        }

        function fallbackCopy(text) {
          var tempInput = document.createElement('textarea');
          tempInput.value = text;
          tempInput.setAttribute('readonly', '');
          tempInput.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0;';
          document.body.appendChild(tempInput);
          tempInput.focus();
          tempInput.select();
          tempInput.setSelectionRange(0, tempInput.value.length);
          var copied = false;
          try { copied = document.execCommand('copy'); } catch (err) { copied = false; }
          document.body.removeChild(tempInput);
          if (window.getSelection) window.getSelection().removeAllRanges();
          return copied;
        }

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(code).then(setCopyFeedback).catch(function() {
            if (fallbackCopy(code)) setCopyFeedback();
          });
        } else {
          if (fallbackCopy(code)) setCopyFeedback();
        }
        return;
      }
    });

    overlay.setAttribute('data-popup-initialized', 'true');
  }

  // Init on DOMContentLoaded or immediately if already loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDiscountPopup);
  } else {
    initDiscountPopup();
  }

  // Re-init when Shopify re-renders the section (theme editor or lazy load)
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target.querySelector('#DiscountPopupOverlay')) {
      initDiscountPopup();
    }
  });
})();
</script>

{% endif %}

{% schema %}
{
  "name": "Discount Popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Enable Popup",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading_small",
      "label": "Small Heading",
      "default": "Ready for a surprise ?"
    },
    {
      "type": "text",
      "id": "heading_large",
      "label": "Large Heading",
      "default": "UNLOCK THE MYSTERY DISCOUNT"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Enter your email and phone to get exclusive discount"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount Code",
      "default": "Surprise10"
    },
    {
      "type": "text",
      "id": "success_description",
      "label": "Success Message",
      "default": "Use this code at checkout for your exclusive discount."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "*only applicable on orders above ₹1,000"
    },
    {
      "type": "range",
      "id": "delay",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Delay before popup appears",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Discount Popup"
    }
  ]
}
{% endschema %}
