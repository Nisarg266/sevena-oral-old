      "faqs2": {
        "type": "faqs2",
        "blocks": {
          "237a58a3-fa98-4cec-8594-8babd759eab7": {
            "type": "collapsible_row",
            "settings": {
              "heading": "When will I receive my order?",
              "row_content": "<p>Excited to get your Super Seven product? So are we, and we’ll make sure that it reaches you within 7 - 10 business days.</p>",
              "page": ""
            }
          },
          "1ef2b412-5fa5-4e77-8a2f-eadbb8be25f2": {
            "type": "collapsible_row",
            "disabled": true,
            "settings": {
              "heading": "Can I get same day delivery?",
              "row_content": "<p>If you’re from Mumbai, we’ve got same day delivery for you - at an added shipping charge that is so small, you’ll hardly notice. </p><p>As for the rest of India, we promise we’re working on getting same day delivery to your city very, very soon.</p>",
              "page": ""
            }
          },
          "37121acb-2f08-4c79-9b08-71d47f459bc4": {
            "type": "collapsible_row",
            "settings": {
              "heading": "Do you offer cash on delivery?",
              "row_content": "<p>Yes we offer cash on delivery for all orders pan India.</p>",
              "page": "frequently-asked-questions"
            }
          },
          "4b904cee-99cc-4397-bd92-3752e8be1b11": {
            "type": "collapsible_row",
            "settings": {
              "heading": "What is your returns & exchange policy?",
              "row_content": "<p></p><p>While we hope that you love your product, in case something is not right with your product, please reach out to us at <a href=\"mailto:wecare@sevenoralcare.com\">wecare@sevenoralcare.com </a>or whatsapp us at +919137986327 and we’ll be happy to exchange it for a new one.</p>",
              "page": ""
            }
          }
        },
